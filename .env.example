# Application Configuration
PROJECT_NAME="Personal Finance Command Center"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="development-only-secret-key-must-be-changed-in-production-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personal_fc"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration (Cache & ARQ background tasks)
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (JSON array string)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Market Data & AI Integration Settings
MARKET_DATA_PROVIDER="mock"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
